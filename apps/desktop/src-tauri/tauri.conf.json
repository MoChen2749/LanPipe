{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LanPipe",
  "version": "0.1.0",
  "identifier": "com.lanpipe.desktop",
  "build": {
    "frontendDist": "../../../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "LanPipe",
    "copyright": "Copyright © 2026 LanPipe",
    "category": "Utility",
    "shortDescription": "局域网文件直传",
    "longDescription": "LanPipe 是局域网文件直传工具：自动发现设备、拖入即传、断点续传，数据不经过云端。",
    "licenseFile": "../../../LICENSE",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "LanPipe"
      },
      "wix": {
        "language": [
          "zh-CN"
        ]
      }
    }
  }
}
